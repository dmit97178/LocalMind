# LocalMind reads cloud credentials directly from the process environment.
# This file is a reference only: the application does not auto-load .env files.
# Set only the variable for the provider selected in your local TOML config.
# Never commit real credential values.

LOCALMIND_DEEPSEEK_API_KEY=
LOCALMIND_GLM_API_KEY=
LOCALMIND_CUSTOM_OPENAI_API_KEY=

# Deprecated DeepSeek-only compatibility fallback. Prefer the provider-specific key.
LOCALMIND_CLOUD_API_KEY=
